{
  "name": "rekixo-site-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-pages.mjs && node --test tests/*.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "configure": "node scripts/prepare-cloudflare.mjs",
    "deploy": "node scripts/prepare-cloudflare.mjs && npx --yes wrangler@4 deploy",
    "dev": "node scripts/prepare-cloudflare.mjs && npx --yes wrangler@4 dev",
    "migrate:remote": "node scripts/prepare-cloudflare.mjs && npx --yes wrangler@4 d1 migrations apply rekixo-site-production --remote"
  }
}
